---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import LogoWall from "../components/LogoWall.astro";
import Servicii from "../components/Servicii.astro";
import Proces from "../components/Proces.astro";
import Testimoniale from "../components/Testimoniale.astro";
import Faq from "../components/Faq.astro";
import CtaFinal from "../components/CtaFinal.astro";
import { site } from "../data/site";
---
<!--
  Portofoliul, investiția și echipa au pagini proprii: /portofoliu,
  /investitie și /echipa. Prima pagină doar trimite spre ele — din meniu,
  din butonul de sub logourile clienților și din secțiunea Servicii.
-->
<Base
  titlu={site.nume}
  descriere={`${site.tagline} Construim site-uri rapide și clare pentru afaceri din România, gândite să transforme vizitatorii în clienți.`}
>
  <Hero />
  <LogoWall />
  <Servicii />
  <Proces />
  <Testimoniale />
  <Faq />
  <CtaFinal />
</Base>
