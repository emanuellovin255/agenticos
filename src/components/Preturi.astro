---
import { pachete, incluseInToate, notitaPret } from "../data/preturi";
import { suprafata } from "../lib/accent";
import Icon from "./Icon.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import { linkWhatsApp } from "../lib/whatsapp";

const mesajPachet = (nume: string, pret: string) =>
  `Bună! Mă interesează pachetul „${nume}” (${pret}) și aș vrea o ofertă personalizată.`;
---
<section id="preturi" class="scroll-mt-24 px-4 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="nb-mic mb-5 inline-block bg-galben px-3.5 py-1.5 text-sm font-bold">Prețuri</p>
      <h2 class="text-3xl font-bold sm:text-5xl">Cât costă și ce primești</h2>
      <p class="mt-5 text-lg text-muted">
        Trei pachete, prețuri afișate. Alegi ce ți se potrivește, iar dacă nu ești sigur,
        îți spunem noi după ce ne povestești ce faci.
      </p>
    </div>

    <ul class="mt-14 grid items-start gap-7 lg:grid-cols-3">
      {pachete.map((p) => (
        <li class={`reveal relative ${p.recomandat ? "lg:-mt-5" : ""}`}>
          {p.recomandat && (
            <p class="nb-mic absolute -top-4 left-1/2 z-10 -translate-x-1/2 bg-negru px-4 py-1.5 text-sm font-bold whitespace-nowrap text-crem">
              Cel mai ales
            </p>
          )}

          <div class={`nb ${p.recomandat ? "nb-gros" : ""} flex h-full flex-col bg-crem`}>
            <!-- capul cardului -->
            <div class={`border-b-[3px] border-negru ${suprafata[p.accent]} px-6 pt-7 pb-6 text-center`}>
              <h3 class="text-2xl font-bold">{p.nume}</h3>
              <p class="mt-4 text-4xl font-bold sm:text-5xl" style="font-family: var(--font-titlu)">{p.pret}</p>
              <p class="mt-3 text-sm font-semibold opacity-80">{p.potrivitPentru}</p>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <p class="text-muted">{p.descriere}</p>

              <p class="mt-6 mb-3 font-bold">Ce include:</p>
              <ul class="space-y-2.5">
                {p.include.map((i) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-0.5 shrink-0 text-coral"><Icon nume="check" marime={18} /></span>
                    <span class="text-muted">{i}</span>
                  </li>
                ))}
              </ul>

              <!-- beneficiile comune, ca sa se vada in fiecare pachet -->
              <ul class="mt-5 space-y-2.5 border-t-2 border-negru/10 pt-5">
                {incluseInToate.map((b) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-0.5 shrink-0 text-coral"><Icon nume="check" marime={18} /></span>
                    <span class="font-semibold">{b.titlu}</span>
                  </li>
                ))}
              </ul>

              <a
                href={linkWhatsApp(mesajPachet(p.nume, p.pret))}
                target="_blank"
                rel="noopener noreferrer"
                class={`nb nb-press mt-7 inline-flex items-center justify-center gap-2.5 px-6 py-4 text-center font-bold ${
                  p.recomandat ? "bg-coral text-negru" : "bg-crem text-negru"
                }`}
                style="font-family: var(--font-titlu)"
              >
                <Icon nume="whatsapp" marime={21} />
                Cere oferta pentru {p.nume.toLowerCase()}
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <!-- ce intra in toate pachetele, explicat pe larg -->
    <div class="nb-gros reveal mt-14 bg-crem-adanc p-7 sm:p-10">
      <p class="text-center text-sm font-bold tracking-wide uppercase text-muted">
        Incluse în toate pachetele, fără cost suplimentar
      </p>
      <ul class="mt-7 grid gap-7 md:grid-cols-2">
        {incluseInToate.map((b) => (
          <li class="nb flex flex-col bg-crem p-6">
            <span class="nb-mic mb-4 grid h-12 w-12 place-items-center bg-galben text-negru">
              <Icon nume={b.icon} marime={24} />
            </span>
            <h3 class="text-xl font-bold">{b.titlu}</h3>
            <p class="mt-2.5 text-muted">{b.descriere}</p>
          </li>
        ))}
      </ul>
    </div>

    <p class="reveal mx-auto mt-8 max-w-2xl text-center text-sm text-muted">{notitaPret}</p>

    <div class="reveal mt-10 flex flex-col items-center gap-3 text-center">
      <p class="text-lg font-semibold">Nu știi care pachet ți se potrivește?</p>
      <p class="max-w-lg text-muted">
        Scrie-ne ce faci și îți spunem sincer de ce ai nevoie — chiar dacă asta înseamnă pachetul mai ieftin.
      </p>
      <div class="mt-3">
        <WhatsAppButton marime="mare" />
      </div>
    </div>
  </div>
</section>
