---
import { site } from "../data/site";
import { numarAfisat } from "../lib/whatsapp";
import WhatsAppButton from "./WhatsAppButton.astro";

const an = new Date().getFullYear();
const social = Object.entries(site.social).filter(([, url]) => url !== "");
---
<footer class="mt-24 border-t-[4px] border-negru bg-negru text-crem">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2">
      <p class="text-2xl font-bold" style="font-family: var(--font-titlu)">{site.nume}</p>
      <p class="mt-3 max-w-sm text-crem/75">{site.tagline}</p>
      <div class="mt-6">
        <WhatsAppButton culoare="galben" eticheta="Hai să vorbim" />
      </div>
    </div>

    <div>
      <p class="font-bold" style="font-family: var(--font-titlu)">Navigare</p>
      <ul class="mt-4 space-y-2.5 text-crem/75">
        <li><a class="hover:text-galben" href="/#servicii">Servicii</a></li>
        <li><a class="hover:text-galben" href="/#portofoliu">Portofoliu</a></li>
        <li><a class="hover:text-galben" href="/#testimoniale">Testimoniale</a></li>
        <li><a class="hover:text-galben" href="/#echipa">Echipa</a></li>
        <li><a class="hover:text-galben" href="/#intrebari">Întrebări frecvente</a></li>
      </ul>
    </div>

    <div>
      <p class="font-bold" style="font-family: var(--font-titlu)">Contact</p>
      <ul class="mt-4 space-y-2.5 text-crem/75">
        <li><a class="hover:text-galben" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{numarAfisat()}</li>
        <li>{site.oras}, România</li>
      </ul>
      {social.length > 0 && (
        <ul class="mt-4 space-y-2.5 text-crem/75">
          {social.map(([nume, url]) => (
            <li>
              <a class="capitalize hover:text-galben" href={url} target="_blank" rel="noopener noreferrer">{nume}</a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="border-t-2 border-crem/15">
    <p class="mx-auto max-w-6xl px-4 py-6 text-sm text-crem/55">
      © {an} {site.nume}. Toate drepturile rezervate.
    </p>
  </div>
</footer>
