---
import { clienti } from "../data/clienti";
import { logoSau } from "../lib/placeholder";
import Icon from "./Icon.astro";

import { suprafata, suprafataSecundar } from "../lib/accent";
const inclinari = ["tilt-1", "tilt-2", "tilt-3"];
---
<section id="portofoliu" class="scroll-mt-24 px-4 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="reveal max-w-2xl">
      <p class="nb-mic mb-5 inline-block bg-coral px-3.5 py-1.5 text-sm font-bold text-negru">Portofoliu</p>
      <h2 class="text-3xl font-bold sm:text-5xl">Lucrări din care poți cere referințe</h2>
      <p class="mt-5 text-lg text-muted">
        Fiecare proiect are o poveste: ce nu funcționa înainte și ce s-a schimbat după.
      </p>
    </div>

    <ul class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {clienti.map((c, i) => (
        <li class="reveal">
          <a
            href={`/portofoliu/${c.slug}`}
            class={`nb nb-press group flex h-full flex-col overflow-hidden bg-crem ${inclinari[i % 3]}`}
          >
            <div class={`flex items-center gap-4 border-b-[3px] border-negru ${suprafata[c.accent]} p-5`}>
              <div
                class="placa-logo h-14 w-24 shrink-0 border-[3px] border-negru p-2"
                style={`--fundal: ${c.logoFundal?.trim() || "#101010"}`}
              >
                <img src={logoSau(c.logo, c.nume, c.accent)} alt="" width="96" height="56" loading="lazy" />
              </div>
              <div class="min-w-0">
                <p class="truncate text-lg font-bold" style="font-family: var(--font-titlu)">{c.nume}</p>
                <p class={`truncate text-sm font-semibold ${suprafataSecundar[c.accent]}`}>{c.oras}</p>
              </div>
            </div>

            <div class="flex flex-1 flex-col p-5">
              <span class="nb-mic mb-4 self-start bg-crem px-2.5 py-1 text-xs font-bold">{c.categorie}</span>
              <p class="line-clamp-4 text-muted">{c.descriere}</p>
              <span
                class="mt-5 inline-flex items-center gap-1.5 pt-1 font-bold text-negru"
                style="font-family: var(--font-titlu)"
              >
                Vezi proiectul
                <span class="transition-transform group-hover:translate-x-1"><Icon nume="sageata" marime={18} /></span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
