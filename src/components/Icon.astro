---
/** Iconite SVG desenate inline. Fara emoji, fara librarii externe. */
export type NumeIcon =
  | "monitor" | "creion" | "cod" | "lupa" | "telefon" | "fulger"
  | "whatsapp" | "play" | "sageata" | "stea" | "plus" | "check" | "meniu" | "inchide";

interface Props { nume: NumeIcon; class?: string; marime?: number }
const { nume, class: cls = "", marime = 24 } = Astro.props;

const cai: Record<NumeIcon, string> = {
  monitor: '<rect x="2.5" y="4" width="19" height="13" rx="2"/><path d="M8.5 21h7M12 17v4"/>',
  creion: '<path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4Z"/><path d="M14.5 5.5 18.5 9.5"/>',
  cod: '<path d="M9 18 3.5 12 9 6"/><path d="M15 6l5.5 6L15 18"/>',
  lupa: '<circle cx="11" cy="11" r="7"/><path d="m20.5 20.5-4.4-4.4"/>',
  telefon: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  fulger: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/>',
  whatsapp:
    '<path d="M20.5 11.6a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.6-4.5A8.4 8.4 0 1 1 20.5 11.6Z"/><path d="M9 9.2c.3-.7.6-.7.9-.7h.6c.2 0 .5 0 .7.5l.8 1.9c.1.2 0 .4-.1.6l-.4.5c-.1.2-.3.3-.1.6a7 7 0 0 0 3 2.6c.3.1.5.1.7-.1l.6-.7c.2-.2.4-.2.6-.1l1.8 1c.2.1.4.2.4.4 0 .6-.3 1.6-1.5 1.9-1.7.4-4-.6-5.7-2.2A9.4 9.4 0 0 1 9 11.4a2.7 2.7 0 0 1 0-2.2Z"/>',
  play: '<path d="M8 5.5 19 12 8 18.5Z"/>',
  sageata: '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  stea: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  meniu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  inchide: '<path d="M6 6l12 12M18 6 6 18"/>',
};

const umplut = nume === "stea" || nume === "play" || nume === "fulger";
---
<svg
  class={cls}
  width={marime}
  height={marime}
  viewBox="0 0 24 24"
  fill={umplut ? "currentColor" : "none"}
  stroke="currentColor"
  stroke-width={umplut ? "1.6" : "2.1"}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={cai[nume]}
/>
