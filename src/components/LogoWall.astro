---
import { clienti, clientiVitrina } from "../data/clienti";
import Icon from "./Icon.astro";

/** Banda ruleaza in bucla: lista se dubleaza ca sa nu apara gol la capat.
 *  In banda trec toti clientii; pe grila stau doar cei opt din vitrina. */
const banda = [...clienti, ...clienti];
const restul = clienti.length - clientiVitrina.length;
/** In romana, "de" se pune doar de la 20 in sus: 9 proiecte, dar 24 de proiecte. */
const restulScris = restul % 100 === 0 || restul % 100 >= 20 ? `${restul} de proiecte` : `${restul} proiecte`;

/** Culoarea placutei din spatele logoului. Cand logoul are fundal
 *  transparent (sau clientul inca nu are logo), placuta ramane in tonul
 *  panoului si, in lipsa logoului, se scrie numele clientului. */
const fundal = (c: (typeof clienti)[number]) => c.logoFundal?.trim() || "#101010";
---
<section class="panou overflow-hidden py-56" aria-labelledby="titlu-logouri">
  <div class="relative mx-auto max-w-6xl px-4 text-center">
    <p class="nb-mic mb-6 inline-block bg-galben px-3.5 py-1.5 text-sm font-bold text-negru">Clienți</p>
    <h2 id="titlu-logouri" class="text-3xl font-bold text-crem sm:text-5xl">
      Ei au deja site de la noi
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-crem/70">
      Șaptesprezece afaceri din România și din străinătate. Apasă pe oricare ca să vezi povestea din spate.
    </p>
  </div>

  <!-- banda in miscare, doar decor: continutul real e grila de mai jos -->
  <div class="banda-container relative mt-14" aria-hidden="true">
    <div class="banda flex w-max gap-5">
      {banda.map((c) => (
        <div class="placa-logo h-[112px] w-[200px] shrink-0 p-4" style={`--fundal: ${fundal(c)}`}>
          {c.logo ? (
            <img src={c.logo} alt="" width="200" height="112" loading="lazy" decoding="async" />
          ) : (
            <span class="text-center text-sm font-bold text-crem/85" style="font-family: var(--font-titlu)">{c.nume}</span>
          )}
        </div>
      ))}
    </div>
    <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-[#0b0b0b] to-transparent sm:w-40"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-[#0b0b0b] to-transparent sm:w-40"></div>
  </div>

  <!-- panoul propriu-zis: opt clienti, navigabili cu tastatura -->
  <ul class="relative mx-auto mt-16 grid max-w-6xl grid-cols-2 gap-4 px-4 sm:grid-cols-3 lg:grid-cols-4">
    {clientiVitrina.map((c) => (
      <li class="reveal">
        <a
          href={`/portofoliu/${c.slug}`}
          class="group flex h-full flex-col items-center gap-3 rounded-2xl px-2 py-3 text-center transition-colors hover:bg-white/5"
        >
          <div
            class="placa-logo h-[128px] w-full p-4 transition-transform duration-200 group-hover:-translate-y-1"
            style={`--fundal: ${fundal(c)}`}
          >
            {c.logo ? (
              <img
                src={c.logo}
                alt={`Logo ${c.nume}`}
                width="240"
                height="128"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="text-center text-lg font-bold text-crem/85" style="font-family: var(--font-titlu)">{c.nume}</span>
            )}
          </div>
          <span class="text-sm leading-tight font-bold text-crem" style="font-family: var(--font-titlu)">{c.nume}</span>
          <span class="-mt-1 text-xs font-semibold text-crem/60">{c.oras}</span>
          <span class="mt-auto pt-1 text-galben opacity-0 transition-opacity group-hover:opacity-100">
            <Icon nume="sageata" marime={18} />
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div class="relative mt-14 px-4 text-center">
    <a
      href="/#portofoliu"
      class="nb nb-press nb-pe-negru inline-flex items-center gap-2.5 bg-galben px-8 py-4 text-lg font-bold text-negru"
      style="font-family: var(--font-titlu)"
    >
      Vezi toate proiectele
      <Icon nume="sageata" marime={20} />
    </a>
    {restul > 0 && (
      <p class="mt-5 text-sm font-semibold text-crem/60">
        Încă {restulScris} în portofoliu, fiecare cu povestea lui
      </p>
    )}
  </div>
</section>
