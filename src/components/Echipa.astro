---
import { Image } from "astro:assets";
import { echipa } from "../data/echipa";
import { avatarPlaceholder } from "../lib/placeholder";

/**
 * Pozele sunt importate din src/assets/, nu din public/, ca Astro sa le
 * optimizeze la build: le micsoreaza, le trece pe webp si scrie dimensiunile
 * in HTML (fara asta, pagina ar sari cand se incarca imaginile).
 */
const pozeEchipa = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/echipa/*.{png,jpg,jpeg,webp}",
  { eager: true },
);

/** Cauta fisierul dupa numele din echipa.ts, indiferent de extensie. */
function pozaPentru(imagine: string): ImageMetadata | undefined {
  if (!imagine) return undefined;
  const cheie = Object.keys(pozeEchipa).find((c) =>
    c.split("/").pop()?.replace(/\.[^.]+$/, "") === imagine,
  );
  return cheie ? pozeEchipa[cheie]!.default : undefined;
}

interface Props {
  /** Pe pagina proprie titlul e h1; ca sectiune intr-o pagina, ramane h2. */
  caPagina?: boolean;
}
const { caPagina = false } = Astro.props;
const Titlu = caPagina ? "h1" : "h2";

const inclinari = ["tilt-1", "tilt-2", "tilt-3"];
---
<section id="echipa" class="scroll-mt-24 border-y-[4px] border-negru bg-crem-adanc px-4 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="reveal max-w-2xl">
      <p class="nb-mic mb-5 inline-block bg-coral px-3.5 py-1.5 text-sm font-bold">Echipa</p>
      <Titlu class="text-3xl font-bold sm:text-5xl">Cine lucrează la site-ul tău</Titlu>
      <p class="mt-5 text-lg text-muted">
        Tu discuți cu o singură persoană, dar în spate lucrează cinci. Fiecare are treaba lui
        clară, ca nimic să nu rămână „al nimănui”.
      </p>
    </div>

    <ul class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {echipa.map((m, i) => {
        const poza = pozaPentru(m.imagine);
        return (
          <li class={`nb nb-press reveal flex flex-col bg-crem p-6 text-center ${inclinari[i % 3]}`}>
            {poza ? (
              <Image
                src={poza}
                alt={m.nume ? `${m.nume}, ${m.rol}` : m.rol}
                width={260}
                height={260}
                densities={[1, 2]}
                loading="lazy"
                class="mx-auto h-40 w-40 object-contain"
              />
            ) : (
              <img
                src={avatarPlaceholder(m.nume || m.rol, m.accent)}
                alt={m.rol}
                width="160"
                height="160"
                loading="lazy"
                class="mx-auto h-40 w-40 object-contain"
              />
            )}

            <h3 class="mt-5 text-base font-bold">{m.nume || m.rol}</h3>
            {m.nume && <p class="mt-0.5 text-sm font-semibold text-muted">{m.rol}</p>}

            <p class="mt-4 flex-1 text-left text-muted">{m.descriere}</p>

            <ul class="mt-5 flex flex-wrap justify-center gap-2">
              {m.atributii.map((a) => (
                <li class="rounded-full border-2 border-negru/25 px-2.5 py-1 text-xs font-semibold text-muted">{a}</li>
              ))}
            </ul>
          </li>
        );
      })}
    </ul>
  </div>
</section>
